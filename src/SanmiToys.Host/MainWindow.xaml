<ui:FluentWindow x:Class="SanmiToys.Host.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:SanmiToys.Host.Views"
                 xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
                 mc:Ignorable="d"
                 Title="SanmiToys" 
                 Height="720" Width="1080"
                 MinHeight="550" MinWidth="750"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Icon="pack://application:,,,/SanmiToys.Host;component/Assets/app.png">
    <ui:FluentWindow.Resources>
        <Style x:Key="HeartSupportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ui:SymbolIcon x:Name="HeartIcon"
                                               Symbol="Heart24"
                                               FontSize="15"
                                               Foreground="#FF4081"
                                               RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <ScaleTransform x:Name="HeartScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="HeartIcon" Property="Foreground" Value="#FF1744"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="HeartbeatStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1.0" To="1.28" Duration="0:0:0.15"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1.0" To="1.28" Duration="0:0:0.15"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             BeginTime="0:0:0.2"
                                                             From="1.0" To="1.18" Duration="0:0:0.12"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             BeginTime="0:0:0.2"
                                                             From="1.0" To="1.18" Duration="0:0:0.12"
                                                             AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             BeginTime="0:0:0.32"
                                                             To="1.0" Duration="0:0:0.68"/>
                                            <DoubleAnimation Storyboard.TargetName="HeartScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             BeginTime="0:0:0.32"
                                                             To="1.0" Duration="0:0:0.68"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="HeartbeatStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeartIcon" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" CenterX="8" CenterY="8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="TitleBar" Title="SanmiToys" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/SanmiToys.Host;component/Assets/app.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <Button x:Name="SupportHeartBtn"
                        Style="{StaticResource HeartSupportButtonStyle}"
                        ToolTip="{loc:Loc Support_Heart_Tooltip}"
                        Click="OnSupportHeartBtnClicked"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content Area with Navigation -->
        <ui:NavigationView x:Name="RootNav" 
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc Nav_Dashboard}" 
                                       Icon="{ui:SymbolIcon Apps28}" 
                                       TargetPageType="{x:Type views:DashboardPage}"/>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItem Content="{loc:Loc Nav_FluidDrag}" 
                                       Icon="{ui:SymbolIcon CursorHover24}" 
                                       TargetPageType="{x:Type views:FluidDragPage}"/>
                <ui:NavigationViewItem Content="{loc:Loc Nav_FocusDimmer}" 
                                       Icon="{ui:SymbolIcon Lightbulb24}" 
                                       TargetPageType="{x:Type views:FocusDimmerPage}"/>
                <ui:NavigationViewItem Content="{loc:Loc Nav_SnapTrans}" 
                                       Icon="{ui:SymbolIcon Translate24}" 
                                       TargetPageType="{x:Type views:SnapTransPage}"/>
                <ui:NavigationViewItem Content="{loc:Loc Nav_SwiftVolume}" 
                                       Icon="{ui:SymbolIcon Speaker224}" 
                                       TargetPageType="{x:Type views:SwiftVolumePage}"/>
                <ui:NavigationViewItem Content="{loc:Loc Nav_OmniGlance}" 
                                       Icon="{ui:SymbolIcon Glance24}" 
                                       TargetPageType="{x:Type views:OmniGlancePage}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <Border x:Name="UpdateBadgeContainer"
                        Margin="8,4,8,6"
                        Visibility="Visible">
                    <ui:Button x:Name="DirectUpdateBtn"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="10,6"
                               CornerRadius="6"
                               Cursor="Hand"
                               Click="OnDirectUpdateBtnClicked">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="UpdateBtnIcon" Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ProgressRing x:Name="UpdateBtnRing" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" IsIndeterminate="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="UpdateBtnText" Text="{loc:Loc General_CheckUpdatesBtn}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </ui:Button>
                </Border>
                <ui:NavigationViewItem Content="{loc:Loc Nav_GeneralSettings}" 
                                       Icon="{ui:SymbolIcon Settings24}" 
                                       TargetPageType="{x:Type views:GeneralSettingsPage}"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
