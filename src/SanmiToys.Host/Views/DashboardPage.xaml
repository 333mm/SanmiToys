<Page x:Class="SanmiToys.Host.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="{loc:Loc Nav_Dashboard}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
            
            <!-- Hero Banner -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="pack://application:,,,/SanmiToys.Host;component/Assets/app.png" Width="46" Height="46" Margin="0,0,18,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Dashboard_Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc Dashboard_Subtitle}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,4,0,12">
                <TextBlock Text="{loc:Loc Dashboard_EnabledModules}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Modules Cards Container -->
            <StackPanel x:Name="ModulesPanel"/>

        </StackPanel>
    </ScrollViewer>
</Page>
