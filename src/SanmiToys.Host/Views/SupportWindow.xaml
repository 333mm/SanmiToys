<ui:FluentWindow x:Class="SanmiToys.Host.Views.SupportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
                  mc:Ignorable="d"
                  Title="{loc:Loc Support_Title}"
                  Width="580" Height="560"
                  MinWidth="500" MinHeight="460"
                  WindowStartupLocation="CenterOwner"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  ResizeMode="NoResize"
                  FontFamily="{loc:LocFont}">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="TitleBar"
                     Grid.Row="0"
                     Title="{loc:Loc Support_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Heart24" Foreground="#FF3366" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,12,28,0">
            <StackPanel>

                <!-- Header Banner -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="#22FF3366"
                            BorderBrush="#44FF3366"
                            BorderThickness="1.5"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FF3366" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Support_Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Support_Intro}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                <!-- OFUSE カード -->
                <ui:CardControl Padding="16" Margin="0,0,0,12">
                    <ui:CardControl.Header>
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Heart24" FontSize="18" Foreground="#FF5E8A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Support_Ofuse_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Support_Ofuse_Desc}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Appearance="Primary"
                               Content="{loc:Loc Support_Ofuse_Btn}"
                               Icon="{ui:SymbolIcon Heart24}"
                               Click="OnOfuseClicked"
                               Cursor="Hand"
                               Padding="14,8"/>
                </ui:CardControl>

                <!-- Ko-fi カード -->
                <ui:CardControl Padding="16" Margin="0,0,0,12">
                    <ui:CardControl.Header>
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="DrinkCoffee24" FontSize="18" Foreground="#FFDD00" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Support_Kofi_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Support_Kofi_Desc}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Appearance="Primary"
                               Content="{loc:Loc Support_Kofi_Btn}"
                               Icon="{ui:SymbolIcon DrinkCoffee24}"
                               Click="OnKoFiClicked"
                               Cursor="Hand"
                               Padding="14,8"/>
                </ui:CardControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="28,12,28,0">
            <ui:Button Content="{loc:Loc Common_Close}"
                       HorizontalAlignment="Right"
                       Appearance="Secondary"
                       Padding="24,6"
                       Click="OnCloseClicked"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
