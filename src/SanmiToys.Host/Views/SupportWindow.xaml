<ui:FluentWindow x:Class="SanmiToys.Host.Views.SupportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
                  mc:Ignorable="d"
                  Title="{loc:Loc Support_Title}"
                  Width="580" Height="580"
                  MinWidth="500" MinHeight="480"
                  WindowStartupLocation="CenterOwner"
                  WindowBackdropType="Mica"
                  ExtendsContentIntoTitleBar="True"
                  ResizeMode="NoResize"
                  FontFamily="{loc:LocFont}">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="TitleBar"
                     Grid.Row="0"
                     Title="{loc:Loc Support_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Heart24" Foreground="#FF3366" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,12,28,0">
            <StackPanel>

                <!-- Header Banner -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="#22FF3366"
                            BorderBrush="#44FF3366"
                            BorderThickness="1.5"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FF3366" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Support_Title}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- Edition Badge -->
                            <Border x:Name="EditionBadge"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EditionBadgeText"
                                           Text="{loc:Loc Support_Mode_Exe_Badge}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Support_Intro}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                <!-- ================= Win32 (EXE) 版 パネル ================= -->
                <StackPanel x:Name="ExeSupportPanel" Visibility="Visible">
                    <!-- OFUSE カード -->
                    <ui:CardControl Padding="16" Margin="0,0,0,12">
                        <ui:CardControl.Header>
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Heart24" FontSize="18" Foreground="#FF5E8A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Support_Ofuse_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Support_Ofuse_Desc}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Appearance="Primary"
                                   Content="{loc:Loc Support_Ofuse_Btn}"
                                   Icon="{ui:SymbolIcon Heart24}"
                                   Click="OnOfuseClicked"
                                   Cursor="Hand"
                                   Padding="14,8"/>
                    </ui:CardControl>

                    <!-- Buy Me a Coffee カード -->
                    <ui:CardControl Padding="16" Margin="0,0,0,12">
                        <ui:CardControl.Header>
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="DrinkCoffee24" FontSize="18" Foreground="#FFDD00" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Support_Bmac_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Support_Bmac_Desc}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Appearance="Primary"
                                   Content="{loc:Loc Support_Bmac_Btn}"
                                   Icon="{ui:SymbolIcon DrinkCoffee24}"
                                   Click="OnBuyMeACoffeeClicked"
                                   Cursor="Hand"
                                   Padding="14,8"/>
                    </ui:CardControl>
                </StackPanel>

                <!-- ================= Microsoft Store (MSIX) 版 パネル ================= -->
                <StackPanel x:Name="StoreSupportPanel" Visibility="Collapsed">
                    <ui:CardControl Padding="16" Margin="0,0,0,12">
                        <ui:CardControl.Header>
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Gift24" FontSize="18" Foreground="#0078D4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Support_Store_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Support_Store_Desc}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Appearance="Primary"
                                   Content="{loc:Loc Support_Store_Btn}"
                                   Icon="{ui:SymbolIcon ShoppingBag24}"
                                   Click="OnStoreAddonClicked"
                                   Cursor="Hand"
                                   Padding="14,8"/>
                    </ui:CardControl>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <TextBlock Text="{loc:Loc Support_Store_Notice}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="28,12,28,0">
            <ui:Button Content="{loc:Loc Common_Close}"
                       HorizontalAlignment="Right"
                       Appearance="Secondary"
                       Padding="24,6"
                       Click="OnCloseClicked"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
