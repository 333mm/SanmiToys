<Page x:Class="SanmiToys.Host.Views.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="{loc:Loc Nav_GeneralSettings}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
            
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="11"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc General_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 言語設定 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,8">
                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc General_LanguageSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_Language_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Language_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageCombo" Width="220" SelectionChanged="OnLanguageSelectionChanged" DisplayMemberPath="DisplayName" SelectedValuePath="Code"/>
            </ui:CardControl>

            <!-- 起動と動作 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,8">
                <ui:SymbolIcon Symbol="Power24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc General_StartupSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_Startup_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Startup_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupSwitch" Checked="OnStartupChanged" Unchecked="OnStartupChanged"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_MinimizeToTray_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_MinimizeToTray_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MinimizeToTraySwitch" IsChecked="True" Checked="OnMinimizeToTrayChanged" Unchecked="OnMinimizeToTrayChanged"/>
            </ui:CardControl>

            <!-- アップデート -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,8">
                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc General_UpdatesSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_Updates_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Updates_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing x:Name="UpdateProgressRing" IsIndeterminate="True" Visibility="Collapsed" Width="20" Height="20" Margin="0,0,12,0"/>
                    <ui:Button x:Name="CheckUpdatesBtn" 
                               Icon="{ui:SymbolIcon ArrowSync24}" 
                               Content="{loc:Loc General_CheckUpdatesBtn}" 
                               Appearance="Secondary" 
                               Click="OnCheckUpdatesClicked"/>
                    <ui:Button x:Name="ApplyUpdateBtn" 
                               Icon="{ui:SymbolIcon ArrowDownload24}" 
                               Content="{loc:Loc General_ApplyUpdateBtn}" 
                               Appearance="Primary" 
                               Visibility="Collapsed" 
                               Margin="8,0,0,0" 
                               Click="OnApplyUpdateClicked"/>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_NotifyOnUpdate_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_NotifyOnUpdate_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NotifyOnUpdateSwitch" IsChecked="True" Checked="OnNotifyOnUpdateChanged" Unchecked="OnNotifyOnUpdateChanged"/>
            </ui:CardControl>

            <!-- 更新状態メッセージ -->
            <ui:InfoBar x:Name="UpdateInfoBar" IsOpen="False" Margin="0,0,0,16" Severity="Informational"/>

            <!-- 開発者支援 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,4">
                <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc General_SupportSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{loc:Loc General_Support_Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,0,0,12"/>

            <!-- OFUSE -->
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_Support_JP_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Support_JP_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Icon="{ui:SymbolIcon Heart24}" 
                           Content="{loc:Loc General_Support_JP_Btn}" 
                           Appearance="Primary" 
                           Click="OnDonateOfuseClicked"/>
            </ui:CardControl>

            <!-- Buy Me a Coffee -->
            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc General_Support_Global_Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_Support_Global_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Icon="{ui:SymbolIcon DrinkCoffee24}" 
                           Content="{loc:Loc General_Support_Global_Btn}" 
                           Appearance="Primary" 
                           Click="OnDonateBuyMeACoffeeClicked"/>
            </ui:CardControl>

            <!-- バージョン情報 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,8">
                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc General_AboutSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="AppVersionText" Text="SanmiToys v1.0.0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc General_About_Author}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock Text="{loc:Loc General_About_Framework}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
