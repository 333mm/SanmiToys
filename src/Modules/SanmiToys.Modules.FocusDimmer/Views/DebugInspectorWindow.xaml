<Window x:Class="SanmiToys.Modules.FocusDimmer.Views.DebugInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        mc:Ignorable="d"
        Title="{loc:Loc FocusDimmer_Inspector_Title}"
        SizeToContent="WidthAndHeight" MaxWidth="520"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{loc:LocFont}">

    <Window.Resources>
        <SolidColorBrush x:Key="InspectorBgBrush" Color="#EE202028"/>
        <SolidColorBrush x:Key="InspectorCardBgBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="InspectorBorderBrush" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="InspectorTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InspectorTextSecondary" Color="#B0B0B8"/>
        <SolidColorBrush x:Key="InspectorAccent" Color="#00E5FF"/>
    </Window.Resources>

    <Border Background="{StaticResource InspectorBgBrush}"
            BorderBrush="{StaticResource InspectorBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Search24" FontSize="20" Foreground="{StaticResource InspectorAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{loc:Loc FocusDimmer_Inspector_Title}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource InspectorTextPrimary}" VerticalAlignment="Center"/>
            </Grid>

            <Border Background="{StaticResource InspectorCardBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                <TextBlock x:Name="StatusText" Text="{loc:Loc FocusDimmer_Inspector_Status}" Foreground="{StaticResource InspectorTextSecondary}" FontSize="12"/>
            </Border>

            <ListView x:Name="WindowList" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="WindowList_SelectionChanged"
                      MinWidth="360" MaxHeight="520">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <EventSetter Event="MouseEnter" Handler="ListViewItem_MouseEnter"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3500E5FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource InspectorBorderBrush}" BorderThickness="0,0,0,1" Padding="8,10" CornerRadius="4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IndexNumber}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource InspectorAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource InspectorTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding ReasonBadge}" FontWeight="Bold" FontSize="11" Foreground="{Binding BadgeForegroundBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DisplayDetails}" Foreground="{StaticResource InspectorTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</Window>
