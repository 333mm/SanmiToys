<Window x:Class="SanmiToys.Modules.SnapTrans.Views.SelectionMiniToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        Title="SnapTrans Selection Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{loc:LocFont}">
    <Grid Margin="2">
        <!-- 透過背景レイヤー (透過率0.7) -->
        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0.7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.2" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <!-- コンテンツレイヤー -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,3">
            <!-- 翻訳ボタン -->
            <ui:Button x:Name="TranslateButton"
                       Icon="{ui:SymbolIcon Translate24}"
                       ToolTip="{loc:Loc SnapTrans_ToolTip_Translate}"
                       Appearance="Secondary"
                       Padding="6,4"
                       Margin="0,0,3,0"
                       Click="OnTranslateClicked"/>

            <!-- コピーボタン -->
            <ui:Button x:Name="CopyButton"
                       Icon="{ui:SymbolIcon Copy24}"
                       ToolTip="{loc:Loc SnapTrans_ToolTip_Copy}"
                       Appearance="Secondary"
                       Padding="6,4"
                       Click="OnCopyClicked"/>
        </StackPanel>
    </Grid>
</Window>
