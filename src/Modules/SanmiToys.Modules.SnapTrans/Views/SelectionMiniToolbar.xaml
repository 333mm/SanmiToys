<Window x:Class="SanmiToys.Modules.SnapTrans.Views.SelectionMiniToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        Title="SnapTrans Selection Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{loc:LocFont}">
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4,3"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" RenderingBias="Performance"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 翻訳ボタン -->
            <ui:Button x:Name="TranslateButton"
                       Icon="{ui:SymbolIcon Translate24}"
                       ToolTip="{loc:Loc SnapTrans_ToolTip_Translate}"
                       Appearance="Secondary"
                       Padding="6,4"
                       Margin="0,0,3,0"
                       Click="OnTranslateClicked"/>

            <!-- コピーボタン -->
            <ui:Button x:Name="CopyButton"
                       Icon="{ui:SymbolIcon Copy24}"
                       ToolTip="{loc:Loc SnapTrans_ToolTip_Copy}"
                       Appearance="Secondary"
                       Padding="6,4"
                       Margin="0,0,3,0"
                       Click="OnCopyClicked"/>

            <!-- 閉じるボタン -->
            <ui:Button x:Name="CloseButton"
                       Icon="{ui:SymbolIcon Dismiss16}"
                       ToolTip="{loc:Loc SnapTrans_ToolTip_Close}"
                       Appearance="Transparent"
                       Padding="6,4"
                       Click="OnCloseClicked"/>
        </StackPanel>
    </Border>
</Window>
