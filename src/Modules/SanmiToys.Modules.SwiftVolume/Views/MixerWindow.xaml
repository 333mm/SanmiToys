<Window x:Class="SanmiToys.Modules.SwiftVolume.Views.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:SanmiToys.Modules.SwiftVolume.Helpers"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        xmlns:local="clr-namespace:SanmiToys.Modules.SwiftVolume.Views"
        Title="{loc:Loc SwiftVolume_Mixer_Title}"
        Width="370"
        Height="460"
        SizeToContent="Height" MaxHeight="850" MinHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="{loc:LocFont}">

    <Window.Resources>
        <helpers:WidthConverter x:Key="WidthConverter"/>

        <!-- Horizontal Slider Thumb Template (Main Volume with Inner Text Value & Accent Highlights) -->
        <ControlTemplate x:Key="MainSliderThumbTemplate" TargetType="Thumb">
            <Border x:Name="ThumbInner" 
                    Width="{TemplateBinding Width}" 
                    Height="{TemplateBinding Height}" 
                    Background="#D0181818" CornerRadius="10" 
                    BorderBrush="#45FFFFFF" BorderThickness="1.5">
                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}"
                           Foreground="White" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                </Border.Effect>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbInner" Property="Background" Value="#F0202020"/>
                    <Setter TargetName="ThumbInner" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbInner" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="ThumbInner" Property="BorderBrush" Value="White"/>
                    <Setter TargetName="ThumbInner" Property="Opacity" Value="0.95"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Base Slider Style (Horizontal for Main Volume with 5% Right-Click Snapping) -->
        <Style x:Key="ToggleSliderStyle" TargetType="Slider">
            <Setter Property="helpers:RightClickDragBehavior.EnableRightClickDrag" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- 背景トラック (未選択の線: Windowsアクセントカラーの半透明) -->
                            <Border x:Name="TrackBackground" Height="4" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.30" VerticalAlignment="Center" Margin="21,0" CornerRadius="2"/>
                            
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="21"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1" Height="4" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Margin="0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="42" Height="20" Template="{StaticResource MainSliderThumbTemplate}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Fluent Acrylic Outer Border -->
    <Border CornerRadius="12" Background="#D8141414" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="348"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Main Left Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header: Master Volume -->
                    <RowDefinition Height="*"/>    <!-- Content: App Sessions -->
                    <RowDefinition Height="Auto"/> <!-- Footer: Mic / Input -->
                </Grid.RowDefinitions>

                <!-- Header: Output Device & Master Volume -->
                <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Device Selector & Expand Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button x:Name="MasterMuteButton" 
                                       Icon="{ui:SymbolIcon Speaker224}" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Appearance="Transparent" 
                                       Padding="4" 
                                       Margin="0,0,6,0"
                                       Click="OnMasterMuteClicked"
                                       ToolTip="{loc:Loc SwiftVolume_Mixer_Tooltip_MuteSpeaker}"/>

                            <ComboBox Grid.Column="1" x:Name="OutputDeviceCombo" SelectionChanged="OnOutputDeviceChanged" VerticalAlignment="Center"/>

                            <ui:Button Grid.Column="2" x:Name="ExpandButton" 
                                       Icon="{ui:SymbolIcon TableStackLeft24}" 
                                       Appearance="Transparent" 
                                       Padding="4" 
                                       Margin="6,0,0,0"
                                       Click="OnToggleExpandClicked"
                                       ToolTip="{loc:Loc SwiftVolume_Mixer_Tooltip_Expand}"/>
                        </Grid>

                        <!-- Master Volume Slider & Peak Meter Indicator -->
                        <Grid Grid.Row="1" Height="26">
                            <!-- Peak Meter Bar behind Slider (Accent Indicator) -->
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.45" CornerRadius="3" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="21,0">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource WidthConverter}" ConverterParameter="42">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        <Binding Path="OutputPeakLevel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <Slider x:Name="MasterVolumeSlider" 
                                    Minimum="0" Maximum="100" Value="50" 
                                    ValueChanged="OnMasterVolumeChanged" 
                                    Style="{StaticResource ToggleSliderStyle}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Application Sessions List (Compact row-by-row layout) -->
                <ScrollViewer Grid.Row="1" x:Name="AppSessionsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <StackPanel x:Name="AppSessionsPanel"/>
                </ScrollViewer>

                <!-- Footer: Input Device Control -->
                <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button x:Name="MicMuteButton" 
                                       Icon="{ui:SymbolIcon Mic24}" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Appearance="Transparent" 
                                       Padding="4" 
                                       Margin="0,0,6,0"
                                       Click="OnMicMuteClicked"
                                       ToolTip="{loc:Loc SwiftVolume_Mixer_Tooltip_MuteMic}"/>

                            <ComboBox Grid.Column="1" x:Name="InputDeviceCombo" SelectionChanged="OnInputDeviceChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Mic Volume Slider & Peak Meter Indicator -->
                        <Grid Grid.Row="1" Height="26">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.45" CornerRadius="3" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="21,0">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource WidthConverter}" ConverterParameter="42">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        <Binding Path="InputPeakLevel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <Slider x:Name="InputVolumeSlider" 
                                    Minimum="0" Maximum="100" Value="50" 
                                    ValueChanged="OnInputVolumeChanged" 
                                    Style="{StaticResource ToggleSliderStyle}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Expanded Panel: All Devices Mixer -->
            <Grid Grid.Column="1" x:Name="ExpandedPanel" Visibility="Collapsed" Margin="10,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ExpandedDevicesPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
