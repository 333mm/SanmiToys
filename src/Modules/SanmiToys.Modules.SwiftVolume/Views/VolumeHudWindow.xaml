<Window x:Class="SanmiToys.Modules.SwiftVolume.Views.VolumeHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        Title="{loc:Loc SwiftVolume_Name}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        MinWidth="294" MinHeight="76"
        WindowStartupLocation="Manual"
        FontFamily="{loc:LocFont}">
    <Border x:Name="MainCard"
            Width="270" Height="52"
            Background="#E0141414"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="18,0"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <!-- Mode 1: Volume Progress Mode -->
            <Grid x:Name="VolumeModeGrid" Height="52" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon x:Name="SpeakerIcon" Symbol="Speaker224" FontSize="22" Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="1" x:Name="VolumeProgress" Height="6" Maximum="100" Value="50" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

                <TextBlock Grid.Column="2" x:Name="VolumeLabel" Text="50" Width="34" TextAlignment="Right" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- Mode 2: Device Switch Mode -->
            <Grid x:Name="DeviceModeGrid" Height="52" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon x:Name="DeviceIcon" Symbol="Speaker224" FontSize="22" Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceTitleText" Text="{loc:Loc SwiftVolume_Hud_SpeakerSwitch}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="DeviceNameText" Text="Realtek High Definition Audio" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ui:ProgressRing Grid.Column="2" x:Name="DeviceSwitchingSpinner" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Mode 3: Mic Mute Status Mode -->
            <Grid x:Name="MicMuteModeGrid" Height="52" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon x:Name="MicMuteIcon" Symbol="MicOff24" FontSize="22" Margin="0,0,12,0" Foreground="#EF4444" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MicMuteStatusText" Text="{loc:Loc SwiftVolume_Hud_MicMuted}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="MicMuteSubText" Text="{loc:Loc SwiftVolume_Tray_Mic}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Mode 4: Speaker Mute Status Mode -->
            <Grid x:Name="SpeakerMuteModeGrid" Height="52" Visibility="Collapsed" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon x:Name="SpeakerMuteIcon" Symbol="SpeakerOff24" FontSize="22" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SpeakerMuteStatusText" Text="{loc:Loc SwiftVolume_Hud_SpeakerMuted}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="SpeakerMuteSubText" Text="{loc:Loc SwiftVolume_Tray_Speaker}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
