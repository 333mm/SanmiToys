<Window x:Class="SanmiToys.Modules.OmniGlance.Views.CalendarEventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="予定の編集"
        Width="440"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, Meiryo, sans-serif">

    <Border Background="#1C1D24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- ヘッダー -->
                <RowDefinition Height="1"/>    <!-- 罫線 -->
                <RowDefinition Height="*"/>    <!-- フォーム内容 -->
                <RowDefinition Height="Auto"/> <!-- アクションボタン -->
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="HeaderIcon" Symbol="CalendarAdd24" FontSize="18" Foreground="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WindowTitleText" Text="新しい予定を追加" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Padding="6,4"
                           Click="OnCloseClicked"
                           ToolTip="閉じる">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#888888"/>
                </ui:Button>
            </Grid>

            <!-- 罫線 -->
            <Rectangle Grid.Row="1" Fill="#1EFFFFFF" Margin="0,0,0,14"/>

            <!-- フォーム内容 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <StackPanel>
                    <!-- タイトル -->
                    <TextBlock Text="タイトル" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleTextBox"
                             FontSize="13"
                             Padding="8,6"
                             Margin="0,0,0,12"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>

                    <!-- 保存先カレンダー -->
                    <TextBlock Text="保存先カレンダー" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CalendarTypeComboBox"
                              Margin="0,0,0,12"
                              FontSize="12"
                              SelectionChanged="OnCalendarTypeChanged">
                        <ComboBoxItem x:Name="LocalCalendarOption" Content="マイカレンダー (ローカル保存)" Tag="Local"/>
                        <ComboBoxItem x:Name="GoogleCalendarOption" Content="Google カレンダー (API 双方向同期)" Tag="Google"/>
                        <ComboBoxItem x:Name="ICloudCalendarOption" Content="iPhone / iCloud カレンダー (CalDAV 双方向同期)" Tag="ICloud"/>
                    </ComboBox>

                    <!-- 日時設定 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="日付" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <DatePicker x:Name="EventDatePicker" Margin="0,0,8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <CheckBox x:Name="AllDayCheckBox"
                                      Content="終日"
                                      FontSize="11"
                                      Foreground="#CCCCCC"
                                      Checked="OnAllDayChanged"
                                      Unchecked="OnAllDayChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 時刻 (終日時は非表示) -->
                    <StackPanel x:Name="TimePanel" Margin="0,0,0,12">
                        <TextBlock Text="時間帯 (開始 - 終了)" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="StartTimeTextBox" Text="10:00" Width="68" FontSize="12" Padding="6,4" Background="#14FFFFFF" Foreground="#FFFFFF" BorderBrush="#30FFFFFF" TextAlignment="Center"/>
                            <TextBlock Text="〜" Foreground="#888888" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="EndTimeTextBox" Text="11:00" Width="68" FontSize="12" Padding="6,4" Background="#14FFFFFF" Foreground="#FFFFFF" BorderBrush="#30FFFFFF" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- カラー選択パレット -->
                    <TextBlock Text="カラー" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <Border x:Name="ColorBtn1" Width="20" Height="20" CornerRadius="10" Background="#4CC2FF" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="2.5" BorderBrush="White" Tag="#4CC2FF"/>
                        <Border x:Name="ColorBtn2" Width="20" Height="20" CornerRadius="10" Background="#52C41A" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#52C41A"/>
                        <Border x:Name="ColorBtn3" Width="20" Height="20" CornerRadius="10" Background="#FF6B6B" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#FF6B6B"/>
                        <Border x:Name="ColorBtn4" Width="20" Height="20" CornerRadius="10" Background="#FFA940" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#FFA940"/>
                        <Border x:Name="ColorBtn5" Width="20" Height="20" CornerRadius="10" Background="#B37FEB" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#B37FEB"/>
                    </StackPanel>

                    <!-- 場所 -->
                    <TextBlock Text="場所 (任意)" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <TextBox x:Name="LocationTextBox"
                             FontSize="12"
                             Padding="8,5"
                             Margin="0,0,0,12"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>

                    <!-- メモ / 説明 -->
                    <TextBlock Text="説明 / メモ (任意)" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionTextBox"
                             FontSize="12"
                             Padding="8,5"
                             Height="54"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>
                </StackPanel>
            </ScrollViewer>

            <!-- アクションボタン -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 削除ボタン (編集時のみ) -->
                <ui:Button Grid.Column="0"
                           x:Name="DeleteEventBtn"
                           Content="削除"
                           Appearance="Transparent"
                           Foreground="#FF4D4F"
                           FontSize="12"
                           Padding="10,6"
                           Click="OnDeleteClicked"
                           Visibility="Collapsed"/>

                <!-- キャンセル & 保存 -->
                <ui:Button Grid.Column="2"
                           Content="キャンセル"
                           Appearance="Secondary"
                           FontSize="12"
                           Padding="12,6"
                           Margin="0,0,8,0"
                           Click="OnCloseClicked"/>

                <ui:Button Grid.Column="3"
                           x:Name="SaveBtn"
                           Content="保存"
                           Appearance="Primary"
                           FontSize="12"
                           Padding="18,6"
                           Click="OnSaveClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
