<Window x:Class="SanmiToys.Modules.OmniGlance.Views.CalendarEventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="予定の編集"
        Width="480"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, Meiryo, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="#1C1D24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- ヘッダー -->
                <RowDefinition Height="1"/>    <!-- 罫線 -->
                <RowDefinition Height="*"/>    <!-- フォーム内容 -->
                <RowDefinition Height="Auto"/> <!-- アクションボタン -->
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="HeaderIcon" Symbol="CalendarAdd24" FontSize="18" Foreground="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WindowTitleText" Text="新しい予定を追加" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Padding="6,4"
                           Click="OnCloseClicked"
                           ToolTip="閉じる">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#888888"/>
                </ui:Button>
            </Grid>

            <!-- 罫線 -->
            <Rectangle Grid.Row="1" Fill="#1EFFFFFF" Margin="0,0,0,10"/>

            <!-- フォーム内容 (スクロール不要の効率的レイアウト) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>
                    <!-- タイトル -->
                    <TextBlock Text="タイトル" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                    <TextBox x:Name="TitleTextBox"
                             FontSize="12.5"
                             Padding="8,5"
                             Margin="0,0,0,8"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>

                    <!-- 保存先カレンダー & カラー (横並び) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 保存先カレンダー -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="保存先カレンダー" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CalendarTypeComboBox"
                                      FontSize="11.5"
                                      SelectionChanged="OnCalendarTypeChanged">
                                <ComboBoxItem x:Name="LocalCalendarOption" Content="マイカレンダー (ローカル保存)" Tag="Local"/>
                                <ComboBoxItem x:Name="GoogleCalendarOption" Content="Google カレンダー (API 双方向同期)" Tag="Google"/>
                                <ComboBoxItem x:Name="ICloudCalendarOption" Content="iPhone / iCloud カレンダー (CalDAV 双方向同期)" Tag="ICloud"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- カラー選択パレット -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="カラー" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ColorBtn1" Width="18" Height="18" CornerRadius="9" Background="#4CC2FF" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="2" BorderBrush="White" Tag="#4CC2FF"/>
                                <Border x:Name="ColorBtn2" Width="18" Height="18" CornerRadius="9" Background="#52C41A" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#52C41A"/>
                                <Border x:Name="ColorBtn3" Width="18" Height="18" CornerRadius="9" Background="#FF6B6B" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#FF6B6B"/>
                                <Border x:Name="ColorBtn4" Width="18" Height="18" CornerRadius="9" Background="#FFA940" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#FFA940"/>
                                <Border x:Name="ColorBtn5" Width="18" Height="18" CornerRadius="9" Background="#B37FEB" Cursor="Hand" MouseLeftButtonDown="OnColorChoiceClicked" BorderThickness="0" BorderBrush="White" Tag="#B37FEB"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 日時設定 & 時間帯 (横並び) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 日付 & 終日 -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="日付" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AllDayCheckBox"
                                          Content="終日"
                                          FontSize="10.5"
                                          Foreground="#CCCCCC"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Checked="OnAllDayChanged"
                                          Unchecked="OnAllDayChanged"/>
                            </Grid>
                            <DatePicker x:Name="EventDatePicker"/>
                        </StackPanel>

                        <!-- 時刻 (終日時は非表示) -->
                        <StackPanel Grid.Column="2" x:Name="TimePanel">
                            <TextBlock Text="時間帯" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="StartTimeTextBox" Text="10:00" Width="64" FontSize="11.5" Padding="4,4" Background="#14FFFFFF" Foreground="#FFFFFF" BorderBrush="#30FFFFFF" TextAlignment="Center"/>
                                <TextBlock Text="〜" Foreground="#888888" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBox x:Name="EndTimeTextBox" Text="11:00" Width="64" FontSize="11.5" Padding="4,4" Background="#14FFFFFF" Foreground="#FFFFFF" BorderBrush="#30FFFFFF" TextAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 場所 -->
                    <TextBlock Text="場所 (任意)" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                    <TextBox x:Name="LocationTextBox"
                             FontSize="11.5"
                             Padding="8,4"
                             Margin="0,0,0,8"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>

                    <!-- メモ / 説明 -->
                    <TextBlock Text="説明 / メモ (任意)" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                    <TextBox x:Name="DescriptionTextBox"
                             FontSize="11.5"
                             Padding="8,4"
                             Height="42"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#14FFFFFF"
                             Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF"/>
                </StackPanel>
            </ScrollViewer>

            <!-- アクションボタン -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 削除ボタン (編集時のみ) -->
                <ui:Button Grid.Column="0"
                           x:Name="DeleteEventBtn"
                           Content="削除"
                           Appearance="Transparent"
                           Foreground="#FF4D4F"
                           FontSize="12"
                           Padding="10,5"
                           Click="OnDeleteClicked"
                           Visibility="Collapsed"/>

                <!-- キャンセル & 保存 -->
                <ui:Button Grid.Column="2"
                           Content="キャンセル"
                           Appearance="Secondary"
                           FontSize="12"
                           Padding="12,5"
                           Margin="0,0,8,0"
                           Click="OnCloseClicked"/>

                <ui:Button Grid.Column="3"
                           x:Name="SaveBtn"
                           Content="保存"
                           Appearance="Primary"
                           FontSize="12"
                           Padding="18,5"
                           Click="OnSaveClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
