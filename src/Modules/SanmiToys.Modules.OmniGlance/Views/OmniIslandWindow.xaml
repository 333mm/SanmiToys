<Window x:Class="SanmiToys.Modules.OmniGlance.Views.OmniIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
        Title="OmniGlance Status Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Typography.NumeralAlignment="Tabular"
        FontFamily="{loc:LocFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- スタイリッシュな物理マウスアイコン (Geometry) 中心(8,8)配置 -->
        <Geometry x:Key="MouseIconGeometry">
            F1 M 8,1 C 5.24,1 3,3.24 3,6 L 3,10 C 3,12.76 5.24,15 8,15 C 10.76,15 13,12.76 13,10 L 13,6 C 13,3.24 10.76,1 8,1 Z M 8,2.2 C 10.1,2.2 11.8,3.9 11.8,6 L 11.8,10 C 11.8,12.1 10.1,13.8 8,13.8 C 5.9,13.8 4.2,12.1 4.2,10 L 4.2,6 C 4.2,3.9 5.9,2.2 8,2.2 Z M 7.4,3.5 C 7.4,3.17 7.67,2.9 8,2.9 C 8.33,2.9 8.6,3.17 8.6,3.5 L 8.6,5.8 C 8.6,6.13 8.33,6.4 8,6.4 C 7.67,6.4 7.4,6.13 7.4,5.8 Z
        </Geometry>

        <!-- スタイリッシュなキーボードアイコン (Geometry) -->
        <Geometry x:Key="KeyboardIconGeometry">
            F1 M 1.5,4 C 1.5,2.6 2.6,1.5 4,1.5 L 12,1.5 C 13.4,1.5 14.5,2.6 14.5,4 L 14.5,12 C 14.5,13.4 13.4,14.5 12,14.5 L 4,14.5 C 2.6,14.5 1.5,13.4 1.5,12 Z M 3,3 C 2.4,3 2,3.4 2,4 L 2,12 C 2,12.6 2.4,13 3,13 L 13,13 C 13.6,13 14,12.6 14,12 L 14,4 C 14,3.4 13.6,3 13,3 Z M 3.5,4.5 L 5,4.5 L 5,6 L 3.5,6 Z M 6,4.5 L 7.5,4.5 L 7.5,6 L 6,6 Z M 8.5,4.5 L 10,4.5 L 10,6 L 8.5,6 Z M 11,4.5 L 12.5,4.5 L 12.5,6 L 11,6 Z M 3.5,7.2 L 5,7.2 L 5,8.7 L 3.5,8.7 Z M 6,7.2 L 7.5,7.2 L 7.5,8.7 L 6,8.7 Z M 8.5,7.2 L 10,7.2 L 10,8.7 L 8.5,8.7 Z M 11,7.2 L 12.5,7.2 L 12.5,8.7 L 11,8.7 Z M 4.5,10 L 11.5,10 L 11.5,11.2 L 4.5,11.2 Z
        </Geometry>

        <!-- スタイリッシュなヘッドホンアイコン (Geometry) 頭部アーチ太め調整 -->
        <Geometry x:Key="HeadphonesIconGeometry">
            F1 M 8,1.2 C 4.2,1.2 1.6,4.2 1.6,8 L 1.6,10 L 3.2,10 L 3.2,8 C 3.2,5 5.3,3 8,3 C 10.7,3 12.8,5 12.8,8 L 12.8,10 L 14.4,10 L 14.4,8 C 14.4,4.2 11.8,1.2 8,1.2 Z M 2.2,8.5 L 3.6,8.5 C 4.3,8.5 4.8,9 4.8,9.7 L 4.8,13.3 C 4.8,14 4.3,14.5 3.6,14.5 L 2.2,14.5 C 1.5,14.5 1,14 1,13.3 L 1,9.7 C 1,9 1.5,8.5 2.2,8.5 Z M 12.4,8.5 L 13.8,8.5 C 14.5,8.5 15,9 15,9.7 L 15,13.3 C 15,14 14.5,14.5 13.8,14.5 L 12.4,14.5 C 11.7,14.5 11.2,14 11.2,13.3 L 11.2,9.7 C 11.2,9 11.7,8.5 12.4,8.5 Z
        </Geometry>

        <!-- スタイリッシュなワイヤレスイヤホン(汎用)アイコン (Geometry) -->
        <Geometry x:Key="EarbudsIconGeometry">
            F1 M 4.5,2 C 2.8,2 1.5,3.3 1.5,5 C 1.5,6.5 2.5,7.7 3.8,7.9 L 3.8,13 C 3.8,13.6 4.3,14 4.8,14 C 5.3,14 5.8,13.6 5.8,13 L 5.8,6.5 C 6.8,6 7.5,5 7.5,3.8 C 7.5,2.8 6.7,2 5.7,2 Z M 11.5,2 C 9.8,2 8.5,3.3 8.5,5 C 8.5,6.5 9.5,7.7 10.8,7.9 L 10.8,13 C 10.8,13.6 11.3,14 11.8,14 C 12.3,14 12.8,13.6 12.8,13 L 12.8,6.5 C 13.8,6 14.5,5 14.5,3.8 C 14.5,2.8 13.7,2 12.7,2 Z
        </Geometry>

        <!-- スタイリッシュな左イヤホン(L)アイコン (Geometry) -->
        <Geometry x:Key="EarbudLeftIconGeometry">
            F1 M 6,2 C 3.8,2 2,3.8 2,6 C 2,7.8 3.2,9.3 4.8,9.8 L 4.8,13.5 C 4.8,14.3 5.5,15 6.2,15 C 7,15 7.6,14.3 7.6,13.5 L 7.6,7.2 C 8.5,6.7 9,5.7 9,4.6 C 9,3.2 7.8,2 6,2 Z M 11.5,4 L 13,4 L 13,11 L 16,11 L 16,12.5 L 11.5,12.5 Z
        </Geometry>

        <!-- スタイリッシュな右イヤホン(R)アイコン (Geometry) -->
        <Geometry x:Key="EarbudRightIconGeometry">
            F1 M 10,2 C 12.2,2 14,3.8 14,6 C 14,7.8 12.8,9.3 11.2,9.8 L 11.2,13.5 C 11.2,14.3 10.5,15 9.8,15 C 9,15 8.4,14.3 8.4,13.5 L 8.4,7.2 C 7.5,6.7 7,5.7 7,4.6 C 7,3.2 8.2,2 10,2 Z M 0.5,4 L 3.5,4 C 4.6,4 5.5,4.8 5.5,5.8 C 5.5,6.6 4.9,7.3 4.1,7.5 L 5.6,12.5 L 3.8,12.5 L 2.6,8 L 2,8 L 2,12.5 L 0.5,12.5 Z M 2,5.3 L 2,6.7 L 3.3,6.7 C 3.8,6.7 4.1,6.3 4.1,6 C 4.1,5.6 3.8,5.3 3.3,5.3 Z
        </Geometry>

        <!-- パルス脈動アニメーション (カプセルのサイズや位置を狂わせない自然な呼吸エフェクト) -->
        <Storyboard x:Key="PulseGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.85" Duration="0:0:1.0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- ルートスケーリングコンテナ (LayoutTransform による無劣化ベクタースケーリング) -->
    <Grid x:Name="MainLayoutRoot" Margin="16">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <!-- メインカプセル本体 -->
        <Border x:Name="IslandPill"
                Height="38"
                CornerRadius="19"
                Background="#F50B0C0E"
                BorderBrush="Transparent"
                BorderThickness="0"
                RenderTransformOrigin="0.5,0.5"
                ClipToBounds="True"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="OnIslandPreviewMouseLeftButtonDown"
                PreviewMouseMove="OnIslandPreviewMouseMove"
                PreviewMouseLeftButtonUp="OnIslandPreviewMouseLeftButtonUp"
                PreviewMouseRightButtonUp="OnIslandPreviewMouseRightButtonUp"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect"
                                  BlurRadius="12"
                                  ShadowDepth="1"
                                  Opacity="0.5"
                                  Color="Black"/>
            </Border.Effect>

            <Grid x:Name="PillContentGrid">
                <!-- ================= 1. COMPACT MODE ================= -->
                <Grid x:Name="CompactGrid" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 1-A. 横表示モード (上部・下部配置時) -->
                    <StackPanel x:Name="CompactStackPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <!-- 時計 (Compact) -->
                        <StackPanel x:Name="ClockCompactSection"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <!-- カレンダー予定ありインジケータ (横モード: 時計の左) -->
                            <Border x:Name="CalendarIndicatorCompact"
                                    Width="6"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed"/>
                            <Grid Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ClockCompactText" Text="12:34" FontWeight="SemiBold" FontSize="13" Foreground="#F0F0F0" Margin="0,-2,0,0" VerticalAlignment="Center" Width="38" TextAlignment="Center"/>
                            <TextBlock x:Name="DayCompactText" Text="Wed" FontSize="10.5" Foreground="#8A8A8E" Margin="3,-1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 時計とパフォーマンス表示の間の薄い罫線 -->
                        <Rectangle x:Name="ClockPerfSeparator"
                                   Width="1"
                                   Height="13"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Fill="#26FFFFFF"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- パフォーマンス (CPU / GPU / RAM / POWER) -->
                        <StackPanel x:Name="PerfCompactSection" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- CPU -->
                            <StackPanel x:Name="CpuCompactItem" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="CpuCompactIcon" Symbol="DeveloperBoard20" FontSize="14" Foreground="#FFB900" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="CpuCompactBorder" Width="38" Height="17" Padding="0" CornerRadius="8" Background="#26FFB900" VerticalAlignment="Center">
                                    <TextBlock x:Name="CpuCompactText" Text="14%" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- GPU -->
                            <StackPanel x:Name="GpuCompactItem" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="GpuCompactIcon" Symbol="WindowDevTools20" FontSize="14" Foreground="#70B0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="GpuCompactBorder" Width="38" Height="17" Padding="0" CornerRadius="8" Background="#2670B0FF" VerticalAlignment="Center">
                                    <TextBlock x:Name="GpuCompactText" Text="0%" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- RAM -->
                            <StackPanel x:Name="RamCompactItem" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="RamCompactIcon" Symbol="Ram20" FontSize="14" Foreground="#26E07F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="RamCompactBorder" Width="38" Height="17" Padding="0" CornerRadius="8" Background="#2626E07F" VerticalAlignment="Center">
                                    <TextBlock x:Name="RamCompactText" Text="45%" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- POWER -->
                            <StackPanel x:Name="PowerCompactItem" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="PowerCompactIcon" Symbol="Flash20" FontSize="14" Foreground="#F58220" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="PowerCompactBorder" Width="38" Height="17" Padding="0" CornerRadius="8" Background="#26F58220" VerticalAlignment="Center">
                                    <TextBlock x:Name="PowerCompactText" Text="35W" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- パフォーマンスとバッテリー表示の間の薄い罫線 -->
                        <Rectangle x:Name="PerfBatterySeparator"
                                   Width="1"
                                   Height="13"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Fill="#26FFFFFF"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- バッテリーステータス一覧 -->
                        <StackPanel x:Name="BatteryCompactSection" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl x:Name="BatteryCompactItemsControl" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding Name}">
                                            <!-- アイコン (各デバイス用ベクターパス / 汎用SymbolIcon) -->
                                            <Grid Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
                                                <!-- マウス -->
                                                <Path Data="{StaticResource MouseIconGeometry}" Width="9" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- キーボード -->
                                                <Path Data="{StaticResource KeyboardIconGeometry}" Width="12" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- ヘッドホン -->
                                                <Path Data="{StaticResource HeadphonesIconGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- イヤホン (汎用) -->
                                                <Path Data="{StaticResource EarbudsIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbuds}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 左イヤホン (L) -->
                                                <Path Data="{StaticResource EarbudLeftIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbudLeft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 右イヤホン (R) -->
                                                <Path Data="{StaticResource EarbudRightIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbudRight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 汎用フォールバック -->
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding DisplayBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAnyEarbud}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>
                                            <!-- バッテリー残量 (%表示 角丸ピルバッジ) -->
                                            <Border Width="38" Height="17" Margin="2,0,0,0" Padding="0" CornerRadius="8" Background="{Binding DisplayBackgroundBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BatteryText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- 1-B. 縦表示モード (左右配置時) -->
                    <StackPanel x:Name="CompactVerticalPanel" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10" Visibility="Collapsed">
                        <!-- 時計 (縦表示 2段) -->
                        <StackPanel x:Name="ClockVerticalSection"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                            <!-- カレンダー予定ありインジケータ (縦モード: 時計の上) -->
                            <Border x:Name="CalendarIndicatorVertical"
                                    Width="6"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,4"
                                    Visibility="Collapsed"/>
                            <!-- 時 (HH) -->
                            <TextBlock x:Name="ClockVerticalHourText"
                                       Text="12"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       LineHeight="14"
                                       LineStackingStrategy="BlockLineHeight"/>
                            <!-- 分 (mm) -->
                            <TextBlock x:Name="ClockVerticalMinText"
                                       Text="34"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       LineHeight="14"
                                       LineStackingStrategy="BlockLineHeight"
                                       Margin="0,1,0,0"/>
                            <!-- 曜日 -->
                            <TextBlock x:Name="DayVerticalText"
                                       Text="Wed"
                                       FontSize="10.5"
                                       Foreground="#8A8A8E"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 時計とパフォーマンス表示の間の薄い横罫線 (縦表示用) -->
                        <Rectangle x:Name="ClockPerfVerticalSeparator"
                                   Width="14"
                                   Height="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Fill="#26FFFFFF"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- パフォーマンス (CPU / GPU / RAM / POWER) - 縦表示 -->
                        <StackPanel x:Name="PerfVerticalSection" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- CPU -->
                            <StackPanel x:Name="CpuVerticalItem" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Grid Width="16" Height="16" HorizontalAlignment="Center">
                                    <ui:SymbolIcon x:Name="CpuVerticalIcon" Symbol="DeveloperBoard20" FontSize="14" Foreground="#FFB900" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="CpuVerticalBorder" Width="30" Height="15" Margin="0,2,0,0" Padding="0" CornerRadius="7" Background="#26FFB900" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CpuVerticalText" Text="14%" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- GPU -->
                            <StackPanel x:Name="GpuVerticalItem" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Grid Width="16" Height="16" HorizontalAlignment="Center">
                                    <ui:SymbolIcon x:Name="GpuVerticalIcon" Symbol="WindowDevTools20" FontSize="14" Foreground="#70B0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="GpuVerticalBorder" Width="30" Height="15" Margin="0,2,0,0" Padding="0" CornerRadius="7" Background="#2670B0FF" HorizontalAlignment="Center">
                                    <TextBlock x:Name="GpuVerticalText" Text="0%" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- RAM -->
                            <StackPanel x:Name="RamVerticalItem" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Grid Width="16" Height="16" HorizontalAlignment="Center">
                                    <ui:SymbolIcon x:Name="RamVerticalIcon" Symbol="Ram20" FontSize="14" Foreground="#26E07F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="RamVerticalBorder" Width="30" Height="15" Margin="0,2,0,0" Padding="0" CornerRadius="7" Background="#2626E07F" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RamVerticalText" Text="45%" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- POWER -->
                            <StackPanel x:Name="PowerVerticalItem" Orientation="Vertical" HorizontalAlignment="Center">
                                <Grid Width="16" Height="16" HorizontalAlignment="Center">
                                    <ui:SymbolIcon x:Name="PowerVerticalIcon" Symbol="Flash20" FontSize="14" Foreground="#F58220" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="PowerVerticalBorder" Width="30" Height="15" Margin="0,2,0,0" Padding="0" CornerRadius="7" Background="#26F58220" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PowerVerticalText" Text="35W" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- パフォーマンスとバッテリー表示の間の薄い横罫線 (縦表示用) -->
                        <Rectangle x:Name="PerfBatteryVerticalSeparator"
                                   Width="14"
                                   Height="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Fill="#26FFFFFF"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- バッテリーステータス一覧 - 縦表示 -->
                        <StackPanel x:Name="BatteryVerticalSection" Orientation="Vertical" HorizontalAlignment="Center">
                            <ItemsControl x:Name="BatteryVerticalItemsControl" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="{Binding Name}">
                                             <!-- アイコン (各デバイス用ベクターパス / 汎用SymbolIcon) -->
                                            <Grid Width="16" Height="16" HorizontalAlignment="Center">
                                                <!-- マウス -->
                                                <Path Data="{StaticResource MouseIconGeometry}" Width="9" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- キーボード -->
                                                <Path Data="{StaticResource KeyboardIconGeometry}" Width="12" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- ヘッドホン -->
                                                <Path Data="{StaticResource HeadphonesIconGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- イヤホン (汎用) -->
                                                <Path Data="{StaticResource EarbudsIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbuds}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 左イヤホン (L) -->
                                                <Path Data="{StaticResource EarbudLeftIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbudLeft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 右イヤホン (R) -->
                                                <Path Data="{StaticResource EarbudRightIconGeometry}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Fill="{Binding DisplayBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarbudRight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <!-- 汎用フォールバック -->
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding DisplayBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAnyEarbud}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>

                                            <!-- バッテリー残量 (%表示 角丸ピルバッジ) -->
                                            <Border Width="30" Height="15" Margin="0,2,0,0" Padding="0" CornerRadius="7" Background="{Binding DisplayBackgroundBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding BatteryText}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ================= 2. ALERT BANNER (低バッテリー警告時 - バー表示形式連動) ================= -->
                <Grid x:Name="AlertGrid" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 2-A. 横表示用アラート (上端・下端・手動配置バー連動) -->
                    <Grid x:Name="AlertHorizontalPanel" Height="38" Margin="12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AlertIconBorder" CornerRadius="11" Width="22" Height="22" Background="#33FF4D4F" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="AlertIcon" Symbol="BatteryWarning24" FontSize="14" Foreground="#FF4D4F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="AlertTitleText" Text="バッテリー残量低下" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" LineHeight="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AlertMessageText" Text="Studio Wireless Pro: 18% remaining" FontSize="10" Foreground="#FFA940" LineHeight="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="2" x:Name="AlertLevelBorder" Background="#33FF4D4F" CornerRadius="10" Padding="7,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="AlertLevelText" Text="18%" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 2-B. 縦表示用アラート (左右エッジ配置バー連動) -->
                    <StackPanel x:Name="AlertVerticalPanel"
                                Width="38"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,4"
                                Visibility="Collapsed">
                        <!-- 警告アイコン (丸形バッジ) -->
                        <Border x:Name="AlertVerticalIconBorder"
                                CornerRadius="10"
                                Width="20"
                                Height="20"
                                Background="#33FF4D4F"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,4">
                            <ui:SymbolIcon x:Name="AlertVerticalIcon"
                                           Symbol="BatteryWarning24"
                                           FontSize="12"
                                           Foreground="#FF4D4F"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                        </Border>

                        <!-- デバイス種別アイコン (マウスまたはSymbol) -->
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <Path x:Name="AlertVerticalMousePath"
                                  Data="{StaticResource MouseIconGeometry}"
                                  Width="9" Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Fill="#FF4D4F"
                                  Visibility="Collapsed"/>
                            <ui:SymbolIcon x:Name="AlertVerticalDeviceIcon"
                                           Symbol="BatteryWarning24"
                                           FontSize="13"
                                           Foreground="#FF4D4F"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Grid>

                        <!-- バッテリー残量パーセント -->
                        <Border x:Name="AlertVerticalLevelBorder"
                                CornerRadius="8"
                                Background="#33FF4D4F"
                                Padding="5,1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,3">
                            <TextBlock x:Name="AlertVerticalLevelText"
                                       Text="18%"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>

                        <!-- LOW / CRIT ステータスバッジ -->
                        <Border x:Name="AlertVerticalBadgeBorder"
                                CornerRadius="3"
                                Background="#33FF4D4F"
                                Padding="4,1"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="AlertVerticalBadgeText"
                                       Text="LOW"
                                       FontSize="8.5"
                                       FontWeight="Bold"
                                       Foreground="#FF4D4F"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= 3. EXPANDED MODE (ホバー・クリック展開時) ================= -->
                <Grid x:Name="ExpandedGrid" Visibility="Collapsed" Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上部バー -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 時計 (クリックでアラーム起動) & 追加タイムゾーン時計 -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip="クリックで Windows アラーム＆クロックを起動"
                                            MouseLeftButtonDown="OnClockClicked">
                                    <TextBlock x:Name="ExpandedTimeText" Text="12:34:56" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedDateText" Text="2026/09/08 (Tue)" FontSize="12" Foreground="#8E8E93" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 展開時 カレンダー当日予定ありバッジ -->
                                <Border x:Name="CalendarExpandedBadge"
                                        Margin="8,2,0,0"
                                        Padding="5,1"
                                        CornerRadius="7"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip="今日の予定 (クリックでカレンダーを表示)"
                                        MouseLeftButtonDown="OnCalendarBadgeClicked"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CalendarLtr20" FontSize="10" Foreground="#FFFFFF" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CalendarExpandedBadgeText" Text="1件の予定" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Windows 追加のタイムゾーン時計 (設定されている場合のみ表示) -->
                            <ItemsControl x:Name="AdditionalClocksItemsControl" Visibility="Collapsed" Margin="0,3,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Globe20" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DayDiffText}" FontSize="9" Foreground="#8E8E93" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="CalendarToggleBtn"
                                       Appearance="Transparent"
                                       Padding="6,4"
                                       Margin="0,0,6,0"
                                       ToolTip="カレンダー表示切替"
                                       Click="OnCalendarToggleClicked">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="14"/>
                            </ui:Button>

                            <ui:Button x:Name="PinBtn"
                                       Appearance="Transparent"
                                       Padding="6,4"
                                       ToolTip="ピン留め (常に展開表示を維持)"
                                       Click="OnPinClicked">
                                <ui:SymbolIcon x:Name="PinBtnIcon" Symbol="Pin24" FontSize="14"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1" Fill="#1EFFFFFF" Margin="0,0,0,10"/>

                    <Grid Grid.Row="2">
                        <!-- メインステータスビュー -->
                        <Grid x:Name="StatusViewGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左カラム: パフォーマンス詳細 (見切れ防止 ScrollViewer 付き) -->
                            <ScrollViewer Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,12,0">
                                <StackPanel VerticalAlignment="Center">
                                    <!-- CPU -->
                                    <StackPanel x:Name="CpuExpandedSection" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <ui:SymbolIcon x:Name="CpuExpandedIcon" Symbol="DeveloperBoard20" FontSize="13" Foreground="#FFB900" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CPU PERFORMANCE" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <ProgressBar x:Name="CpuProgressBar" Height="4" Value="14" Maximum="100" Foreground="#FFB900" Background="#262626"/>
                                        </Grid>
                                        <Grid VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border x:Name="CpuExpandedBorder" Width="42" Height="18" Padding="0" CornerRadius="9" Background="#26FFB900" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CpuPercentLabel" Text="14%" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text=" load" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="CpuTempBorder" Width="50" Height="18" Padding="0" CornerRadius="9" Background="#26FFB900" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="CpuTempIcon" Symbol="Temperature20" FontSize="11" Foreground="#FFB900" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CpuTempLabel" Text="45°C" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- GPU -->
                                    <StackPanel x:Name="GpuExpandedSection" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <ui:SymbolIcon x:Name="GpuExpandedIcon" Symbol="WindowDevTools20" FontSize="13" Foreground="#70B0FF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GPU PERFORMANCE" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <ProgressBar x:Name="GpuProgressBar" Height="4" Value="0" Maximum="100" Foreground="#70B0FF" Background="#262626"/>
                                        </Grid>
                                        <Grid VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border x:Name="GpuExpandedBorder" Width="42" Height="18" Padding="0" CornerRadius="9" Background="#2670B0FF" VerticalAlignment="Center">
                                                    <TextBlock x:Name="GpuPercentLabel" Text="0%" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text=" load" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="GpuTempBorder" Width="50" Height="18" Padding="0" CornerRadius="9" Background="#2670B0FF" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon x:Name="GpuTempIcon" Symbol="Temperature20" FontSize="11" Foreground="#70B0FF" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="GpuTempLabel" Text="42°C" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- RAM -->
                                    <StackPanel x:Name="RamExpandedSection" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <ui:SymbolIcon x:Name="RamExpandedIcon" Symbol="Ram20" FontSize="13" Foreground="#26E07F" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MEMORY (RAM)" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <ProgressBar x:Name="RamProgressBar" Height="4" Value="45" Maximum="100" Foreground="#26E07F" Background="#262626"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="RamExpandedBorder" Width="42" Height="18" Padding="0" CornerRadius="9" Background="#2626E07F" VerticalAlignment="Center">
                                                <TextBlock x:Name="RamPercentLabel" Text="45%" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="RamDetailLabel" Text=" (14.4 / 32 GB)" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- POWER -->
                                    <StackPanel x:Name="PowerExpandedSection">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <ui:SymbolIcon x:Name="PowerExpandedIcon" Symbol="Flash20" FontSize="13" Foreground="#F58220" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MACHINE POWER" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="PowerExpandedBorder" Width="42" Height="18" Padding="0" CornerRadius="9" Background="#26F58220" VerticalAlignment="Center">
                                                <TextBlock x:Name="PowerWattsLabel" Text="35W" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="PowerSourceLabel" Text=" (AC Power)" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Rectangle Grid.Column="1" Fill="#1AFFFFFF"/>

                            <!-- 右カラム: バッテリー詳細リスト -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONNECTED DEVICES" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,6"/>

                                    <ItemsControl x:Name="ExpandedDeviceItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="Auto"/>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="60"/>
                                                             <ColumnDefinition Width="52"/>
                                                         </Grid.ColumnDefinitions>

                                                            <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <!-- マウス -->
                                                                <Path Data="{StaticResource MouseIconGeometry}" Width="9" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- キーボード -->
                                                                <Path Data="{StaticResource KeyboardIconGeometry}" Width="13" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- ヘッドホン -->
                                                                <Path Data="{StaticResource HeadphonesIconGeometry}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- イヤホン (汎用) -->
                                                                <Path Data="{StaticResource EarbudsIconGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEarbuds}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- 左イヤホン (L) -->
                                                                <Path Data="{StaticResource EarbudLeftIconGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEarbudLeft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- 右イヤホン (R) -->
                                                                <Path Data="{StaticResource EarbudRightIconGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      Fill="{Binding DisplayBrush}">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEarbudRight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <!-- 汎用フォールバック -->
                                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" VerticalAlignment="Center"
                                                                               Foreground="{Binding DisplayBrush}">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouse}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsHeadphones}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsAnyEarbud}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </Grid>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                               <!-- 展開時の充電中ステータスバッジ -->
                                                               <Border Margin="6,0,0,0"
                                                                       Padding="4,1"
                                                                       Background="#2052C41A"
                                                                       BorderBrush="#5552C41A"
                                                                       BorderThickness="1"
                                                                       CornerRadius="3"
                                                                       VerticalAlignment="Center">
                                                                   <Border.Style>
                                                                       <Style TargetType="Border">
                                                                           <Setter Property="Visibility" Value="Collapsed"/>
                                                                           <Style.Triggers>
                                                                               <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                                                   <Setter Property="Visibility" Value="Visible"/>
                                                                               </DataTrigger>
                                                                           </Style.Triggers>
                                                                       </Style>
                                                                   </Border.Style>
                                                                   <TextBlock Text="{loc:Loc OmniGlance_Battery_Charging}"
                                                                              FontSize="9"
                                                                              FontWeight="Bold"
                                                                              Foreground="#52C41A"
                                                                              VerticalAlignment="Center"/>
                                                               </Border>
                                                           </StackPanel>

                                                          <ProgressBar Grid.Column="2" Height="5" Value="{Binding BatteryLevel}" Maximum="100" VerticalAlignment="Center" Margin="6,0"
                                                                       Foreground="{Binding DisplayBrush}" Background="#2A2A2A"/>

                                                          <!-- バッテリーパーセンテージ (角丸ピルバッジ) -->
                                                          <Border Grid.Column="3"
                                                                  Width="42"
                                                                  Height="18"
                                                                  Padding="0"
                                                                  Background="{Binding DisplayBackgroundBrush}"
                                                                  CornerRadius="9"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Right">
                                                              <TextBlock Text="{Binding BatteryText}"
                                                                         FontSize="11.5"
                                                                         FontWeight="Bold"
                                                                         Foreground="#FFFFFF"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         TextAlignment="Center"/>
                                                          </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- カレンダービュー (Fluent 2カラムカスタムカレンダー) -->
                        <Grid x:Name="CalendarViewGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左カラム: 月間ミニカレンダー -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <!-- 年月ナビゲーション -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:Button x:Name="CalendarPrevMonthBtn"
                                               Appearance="Transparent"
                                               Padding="4,2"
                                               Click="OnCalendarPrevMonthClicked">
                                        <ui:SymbolIcon Symbol="ChevronLeft16" FontSize="11"/>
                                    </ui:Button>

                                    <TextBlock Grid.Column="1"
                                               x:Name="CalendarMonthTitleText"
                                               Text="2026年 9月"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <ui:Button Grid.Column="2"
                                               x:Name="CalendarNextMonthBtn"
                                               Appearance="Transparent"
                                               Padding="4,2"
                                               Click="OnCalendarNextMonthClicked">
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="11"/>
                                    </ui:Button>

                                    <ui:Button Grid.Column="3"
                                               x:Name="CalendarTodayBtn"
                                               Appearance="Transparent"
                                               Padding="4,2"
                                               Margin="2,0,0,0"
                                               Click="OnCalendarTodayClicked"
                                               ToolTip="今日へ移動">
                                        <TextBlock Text="今日" FontSize="10" Foreground="#4CC2FF"/>
                                    </ui:Button>
                                </Grid>

                                <!-- 曜日ヘッダー -->
                                <UniformGrid Columns="7" Margin="0,0,0,3">
                                    <TextBlock Text="日" FontSize="9" FontWeight="SemiBold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="月" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                    <TextBlock Text="火" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                    <TextBlock Text="水" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                    <TextBlock Text="木" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                    <TextBlock Text="金" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                    <TextBlock Text="土" FontSize="9" FontWeight="SemiBold" Foreground="#4CC2FF" HorizontalAlignment="Center"/>
                                </UniformGrid>

                                <!-- 日付グリッド (7x6) -->
                                <ItemsControl x:Name="CalendarDaysItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" Rows="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6"
                                                    Margin="1"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="OnCalendarDayCellClicked"
                                                    ToolTip="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}">
                                                <Grid Height="19">
                                                    <TextBlock Text="{Binding DayNumber}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <!-- イベントカラードット一覧 -->
                                                    <ItemsControl ItemsSource="{Binding EventDotBrushes}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Bottom"
                                                                  Margin="0,0,0,1">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="3.5" Height="3.5" Margin="0.8,0" Fill="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 区切り線 -->
                            <Rectangle Grid.Column="1" Fill="#1AFFFFFF"/>

                            <!-- 右カラム: 選択日スケジュールリスト & 予定追加 -->
                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 選択日ヘッダー & 予定追加ボタン -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SelectedDateHeaderText"
                                               Text="9月8日 (火) の予定"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#EEEEEE"
                                               VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1"
                                               x:Name="AddEventBtn"
                                               Appearance="Transparent"
                                               Padding="4,2"
                                               Click="OnAddEventClicked"
                                               ToolTip="予定を追加">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add16" FontSize="11" Foreground="#4CC2FF" Margin="0,0,3,0"/>
                                            <TextBlock Text="追加" FontSize="10" Foreground="#4CC2FF"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <!-- 予定カードリスト -->
                                <ScrollViewer x:Name="DateEventsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- 予定なし時表示 -->
                                        <TextBlock x:Name="NoEventsPlaceholder"
                                                   Text="予定はありません"
                                                   FontSize="11"
                                                   Foreground="#777777"
                                                   Margin="0,20,0,0"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed"/>

                                         <ItemsControl x:Name="DateEventsItemsControl">
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <Border Background="#14FFFFFF" CornerRadius="4,6,6,4" Padding="10,5,8,5" Margin="0,0,0,5" BorderThickness="3,0,0,0" BorderBrush="{Binding ColorBrush}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FFFFFF"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1"
                                                                        Background="#2A4CC2FF"
                                                                        CornerRadius="4"
                                                                        Padding="4,1"
                                                                        Margin="0,0,4,0"
                                                                        Visibility="{Binding IsAllDay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                                    <TextBlock Text="終日" FontSize="9" Foreground="#4CC2FF"/>
                                                                </Border>
                                                                <!-- Web で開く (Google / iCloud) -->
                                                                <ui:Button Grid.Column="2"
                                                                           Appearance="Transparent"
                                                                           Padding="2"
                                                                           Margin="2,0,0,0"
                                                                           ToolTip="Web カレンダーで開く"
                                                                           Click="OnOpenEventWebClicked"
                                                                           Visibility="{Binding CanOpenWeb, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                                    <ui:SymbolIcon Symbol="Open16" FontSize="10" Foreground="#4CC2FF"/>
                                                                </ui:Button>
                                                                <!-- 編集ボタン (ローカル / iCloud) -->
                                                                <ui:Button Grid.Column="3"
                                                                           Appearance="Transparent"
                                                                           Padding="2"
                                                                           Margin="2,0,0,0"
                                                                           ToolTip="予定を編集"
                                                                           Click="OnEditEventClicked"
                                                                           Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                                    <ui:SymbolIcon Symbol="Edit16" FontSize="10" Foreground="#CCCCCC"/>
                                                                </ui:Button>
                                                                <!-- 削除ボタン -->
                                                                <ui:Button Grid.Column="4"
                                                                           Appearance="Transparent"
                                                                           Padding="2"
                                                                           Margin="2,0,0,0"
                                                                           ToolTip="予定を削除"
                                                                           Click="OnDeleteCustomEventClicked"
                                                                           Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" Foreground="#888888"/>
                                                                </ui:Button>
                                                            </Grid>

                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Clock20" FontSize="11" Foreground="#8E8E93" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Location, StringFormat='  •  {0}'}"
                                                                           FontSize="10"
                                                                           Foreground="#8E8E93"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding HasLocation, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                     </Border>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>



                                <!-- 最下部: 同期ステータス -->
                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <TextBlock x:Name="CalendarSyncStatusText"
                                               Text="同期: 成功 (4件)"
                                               FontSize="10"
                                               Foreground="#6E6E73"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
