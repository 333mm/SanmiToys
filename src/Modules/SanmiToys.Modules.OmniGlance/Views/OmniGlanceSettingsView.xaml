<UserControl x:Class="SanmiToys.Modules.OmniGlance.Views.OmniGlanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SanmiToys.Core.Markup;assembly=SanmiToys.Core"
             mc:Ignorable="d" 
             d:DesignHeight="1300" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- スタイリッシュな物理マウスアイコン (Geometry) -->
        <Geometry x:Key="MouseIconGeometry">
            F1 M 6,1 C 3.24,1 1,3.24 1,6 L 1,10 C 1,12.76 3.24,15 6,15 C 8.76,15 11,12.76 11,10 L 11,6 C 11,3.24 8.76,1 6,1 Z M 6,2.2 C 8.1,2.2 9.8,3.9 9.8,6 L 9.8,10 C 9.8,12.1 8.1,13.8 6,13.8 C 3.9,13.8 2.2,12.1 2.2,10 L 2.2,6 C 2.2,3.9 3.9,2.2 6,2.2 Z M 5.4,3.5 C 5.4,3.17 5.67,2.9 6,2.9 C 6.33,2.9 6.6,3.17 6.6,3.5 L 6.6,5.8 C 6.6,6.13 6.33,6.4 6,6.4 C 5.67,6.4 5.4,6.13 5.4,5.8 Z
        </Geometry>

        <!-- モニター配置画面の右側用: チェックボックス本体を右端に配置して左右対称に整列するスタイル -->
        <Style x:Key="RightAlignedCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="0"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="0,0,8,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <Border x:Name="ControlBorderIconPresenter"
                                    Grid.Column="1"
                                    CornerRadius="{TemplateBinding Border.CornerRadius}"
                                    Background="{TemplateBinding Background}"
                                    Width="{DynamicResource CheckBoxHeight}"
                                    Height="{DynamicResource CheckBoxWidth}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border x:Name="StrokeBorder"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                                    <ui:SymbolIcon x:Name="ControlIcon"
                                                   Symbol="Checkmark48"
                                                   FontSize="{DynamicResource CheckBoxIconSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource CheckBoxCheckGlyphForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ContentControl.Content" Value="{x:Null}">
                                <Setter TargetName="ContentPresenter" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}"/>
                                <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="{x:Null}">
                                <Setter TargetName="ControlIcon" Property="Symbol" Value="{x:Static ui:SymbolRegular.Subtract16}"/>
                                <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}"/>
                                <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="False"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="StrokeBorder" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPointerOver}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="StrokeBorder" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPressed}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="False"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}"/>
                                <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPressed}"/>
                                <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedDisabled}"/>
                                <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}"/>
                                <Setter TargetName="ControlIcon" Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="11"
                            Background="#1C0078D4"
                            BorderBrush="#380078D4"
                            BorderThickness="1"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Glance24" FontSize="22" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc OmniGlance_Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="2" x:Name="EnableSwitch" Checked="OnEnableChanged" Unchecked="OnEnableChanged" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 配置とスタイル設定 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,8">
                <ui:SymbolIcon Symbol="WindowApps24" FontSize="16" Foreground="#0078D4" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc OmniGlance_LayoutSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- 表示モード -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="表示モード" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="OmniGlance のカプセルを横長バーまたは縦長サイドバーで表示します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HorizontalModeRadio" Content="横表示モード" GroupName="IslandOrientationGroup" Margin="0,0,16,0" Checked="OnOrientationChanged"/>
                    <RadioButton x:Name="VerticalModeRadio" Content="縦表示モード" GroupName="IslandOrientationGroup" Checked="OnOrientationChanged"/>
                </StackPanel>
            </ui:CardControl>

            <!-- カラーモード -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="カラーモード" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="各アイコンやバッジの配色をカラフルなアクセント表示または統一感のあるモノトーン表示から選択します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ColorModeRadio" Content="カラーモード" GroupName="IslandColorModeGroup" Margin="0,0,16,0" Checked="OnColorModeChanged"/>
                    <RadioButton x:Name="MonochromeModeRadio" Content="モノトーンモード" GroupName="IslandColorModeGroup" Checked="OnColorModeChanged"/>
                </StackPanel>
            </ui:CardControl>

            <!-- バッジ背景の表示 -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="バッジ背景の表示" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="数値の半透明角丸背景バッジを表示します。オフにすると文字のみのミニマル表示になります" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ShowBadgeBackgroundSwitch" Checked="OnShowBadgeBackgroundChanged" Unchecked="OnShowBadgeBackgroundChanged"/>
            </ui:CardControl>

            <!-- 配置位置 -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="配置位置" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="画面上の表示位置を選択します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4">
                    <!-- モニター画面ベゼル (PCディスプレイ風フレーム) -->
                    <Border Width="260" Height="130"
                            Background="#111214"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid>
                            <!-- 横モード用配置 (3列×2行) -->
                            <Grid x:Name="HorizontalSlotsGrid" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="SlotH_StartStart" Content="左上" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="SlotH_CenterStart" Content="上" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" x:Name="SlotH_EndStart" Content="右上" FontSize="11" Style="{StaticResource RightAlignedCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="SlotH_StartEnd" Content="左下" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SlotH_CenterEnd" Content="下" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SlotH_EndEnd" Content="右下" FontSize="11" Style="{StaticResource RightAlignedCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Click="OnSlotCheckboxClicked"/>
                            </Grid>

                            <!-- 縦モード用配置 (2列×3行) -->
                            <Grid x:Name="VerticalSlotsGrid" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="SlotV_StartStart" Content="左上" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="SlotV_StartCenter" Content="左" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="SlotV_StartEnd" Content="左下" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="SlotV_EndStart" Content="右上" FontSize="11" Style="{StaticResource RightAlignedCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SlotV_EndCenter" Content="右" FontSize="11" Style="{StaticResource RightAlignedCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Click="OnSlotCheckboxClicked"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="SlotV_EndEnd" Content="右下" FontSize="11" Style="{StaticResource RightAlignedCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Click="OnSlotCheckboxClicked"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- モニタースタンド (支柱 & 台座) -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="18" Height="7" Background="#26282E" HorizontalAlignment="Center"/>
                        <Border Width="68" Height="4" Background="#34363F" CornerRadius="2" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_LockPosition}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_LockPosition_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="LockPositionSwitch" Checked="OnLockPositionChanged" Unchecked="OnLockPositionChanged"/>
            </ui:CardControl>

            <!-- 表示倍率 (スケール) -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_Scale}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_Scale_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="ScaleSlider" Minimum="70" Maximum="150" Value="120" Width="160" Margin="0,0,12,0" ValueChanged="OnScaleChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52">
                        <TextBlock x:Name="ScaleText" Text="120%" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_AutoExpand}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_AutoExpand_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoExpandSwitch" Checked="OnAutoExpandChanged" Unchecked="OnAutoExpandChanged"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_ClickThrough}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_ClickThrough_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ClickThroughSwitch" Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_Opacity}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_Opacity_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Width="160" Margin="0,0,12,0" ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52">
                        <TextBlock x:Name="OpacityText" Text="95%" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:CardControl>

            <!-- 表示コンテンツ項目 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,8">
                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="16" Foreground="#0078D4" Margin="0,0,8,0"/>
                <TextBlock Text="{loc:Loc OmniGlance_ContentSection}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowClock}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowClock_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ShowClockSwitch" Checked="OnShowClockChanged" Unchecked="OnShowClockChanged"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowPerf}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowPerf_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ShowPerfSwitch" Checked="OnShowPerfChanged" Unchecked="OnShowPerfChanged"/>
            </ui:CardControl>

            <!-- パフォーマンスモニタ子オプション (CPU / GPU / RAM / マシン消費電力) -->
            <Border x:Name="PerfSubOptionsPanel"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="16,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc OmniGlance_PerfSubOptions_Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                    <!-- CPU 使用率 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="14" Foreground="#FFB900" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc OmniGlance_ShowCpu}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShowCpuCheckBox" Checked="OnPerfSubOptionChanged" Unchecked="OnPerfSubOptionChanged" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- GPU 使用率 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="14" Foreground="#70B0FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc OmniGlance_ShowGpu}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShowGpuCheckBox" Checked="OnPerfSubOptionChanged" Unchecked="OnPerfSubOptionChanged" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- RAM 使用率 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Ram20" FontSize="14" Foreground="#26E07F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc OmniGlance_ShowRam}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShowRamCheckBox" Checked="OnPerfSubOptionChanged" Unchecked="OnPerfSubOptionChanged" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- マシン消費電力 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash20" FontSize="14" Foreground="#F58220" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc OmniGlance_ShowPower}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShowPowerCheckBox" Checked="OnPerfSubOptionChanged" Unchecked="OnPerfSubOptionChanged" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowBattery}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_ShowBattery_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ShowBatterySwitch" Checked="OnShowBatteryChanged" Unchecked="OnShowBatteryChanged"/>
            </ui:CardControl>

            <!-- バッテリー子オプション (現在表示可能なデバイス一覧) -->
            <Border x:Name="BatterySubOptionsPanel"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="16,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc OmniGlance_BatterySubOptions_Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                    <TextBlock x:Name="NoDevicesDetectedText"
                               Text="{loc:Loc OmniGlance_NoDevicesDetected}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               FontStyle="Italic"
                               Visibility="Collapsed"
                               Margin="0,4"/>

                    <ItemsControl x:Name="BatterySubOptionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                         <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource MouseIconGeometry}"
                                                  Width="9.5" Height="12.5"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Fill" Value="#4CC2FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouse}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCriticalBattery}" Value="True">
                                                                <Setter Property="Fill" Value="#FF4D4F"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLowBattery}" Value="True">
                                                                <Setter Property="Fill" Value="#FFA940"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                                <Setter Property="Fill" Value="#52C41A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="#4CC2FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouse}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCriticalBattery}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF4D4F"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLowBattery}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFA940"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                                <Setter Property="Foreground" Value="#52C41A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <!-- 充電中バッジ -->
                                        <Border Margin="6,0,0,0"
                                                Padding="4,1"
                                                Background="#2052C41A"
                                                BorderBrush="#5552C41A"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Loc OmniGlance_Battery_Charging}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#52C41A"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding BatteryText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsOptionEnabled}"
                                              Tag="{Binding Id}"
                                              Checked="OnBatteryDeviceOptionChanged"
                                              Unchecked="OnBatteryDeviceOptionChanged"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- アラート・警告通知設定 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,8">
                <ui:SymbolIcon Symbol="Alert24" FontSize="16" Foreground="#0078D4" Margin="0,0,8,0"/>
                <TextBlock Text="アラート・警告通知設定" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- パルスアニメーション -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_PulseAnim}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_PulseAnim_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PulseAnimSwitch" Checked="OnPulseAnimChanged" Unchecked="OnPulseAnimChanged"/>
            </ui:CardControl>

            <!-- バッテリー警告 (低残量) -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_LowThreshold}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_LowThreshold_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="LowThresholdSlider" Minimum="15" Maximum="50" Width="160" Margin="0,0,12,0" ValueChanged="OnLowThresholdChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52">
                        <TextBlock x:Name="LowThresholdText" Text="20%" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:CardControl>

            <!-- バッテリー警告 (危険残量) -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_CriticalThreshold}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_CriticalThreshold_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="CriticalThresholdSlider" Minimum="5" Maximum="20" Width="160" Margin="0,0,12,0" ValueChanged="OnCriticalThresholdChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52">
                        <TextBlock x:Name="CriticalThresholdText" Text="10%" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:CardControl>

            <!-- CPU 高温警告 -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="CPU 高温警告" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="CPU温度が指定値に達したときに警告バナーを表示します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="CpuTempThresholdSlider" Minimum="60" Maximum="95" Width="160" Margin="0,0,12,0" ValueChanged="OnCpuTempThresholdChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52" Margin="0,0,16,0">
                        <TextBlock x:Name="CpuTempThresholdText" Text="80°C" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                    <ui:ToggleSwitch x:Name="EnableCpuTempAlertSwitch" Checked="OnEnableCpuTempAlertChanged" Unchecked="OnEnableCpuTempAlertChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:CardControl>

            <!-- GPU 高温警告 -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="GPU 高温警告" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="GPU温度が指定値に達したときに警告バナーを表示します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="GpuTempThresholdSlider" Minimum="60" Maximum="95" Width="160" Margin="0,0,12,0" ValueChanged="OnGpuTempThresholdChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52" Margin="0,0,16,0">
                        <TextBlock x:Name="GpuTempThresholdText" Text="80°C" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                    <ui:ToggleSwitch x:Name="EnableGpuTempAlertSwitch" Checked="OnEnableGpuTempAlertChanged" Unchecked="OnEnableGpuTempAlertChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:CardControl>

            <!-- メモリ使用量警告 -->
            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="メモリ使用量警告" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="メモリ（RAM）使用率が指定値に達したときに警告バナーを表示します" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="MemoryThresholdSlider" Minimum="70" Maximum="98" Width="160" Margin="0,0,12,0" ValueChanged="OnMemoryThresholdChanged" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" MinWidth="52" Margin="0,0,16,0">
                        <TextBlock x:Name="MemoryThresholdText" Text="85%" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                    <ui:ToggleSwitch x:Name="EnableMemoryAlertSwitch" Checked="OnEnableMemoryAlertChanged" Unchecked="OnEnableMemoryAlertChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:CardControl>

            <!-- テスト & シミュレーション -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,8">
                <ui:SymbolIcon Symbol="Beaker24" FontSize="16" Foreground="#0078D4" Margin="0,0,8,0"/>
                <TextBlock Text="テスト・シミュレーション" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- デモ用デバイスシミュレーション -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OmniGlance_DemoDevices}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc OmniGlance_DemoDevices_Desc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DemoDevicesSwitch" Checked="OnDemoDevicesChanged" Unchecked="OnDemoDevicesChanged"/>
            </ui:CardControl>

            <!-- アラート通知のテスト表示 -->
            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="警告アラート表示のテスト" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="各警告が発生した際のカプセル展開とアニメーション効果をテストします" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0" Click="OnTestBatteryAlertClicked" ToolTip="低バッテリー警告をテスト">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BatteryWarning24" FontSize="14" Margin="0,0,6,0" Foreground="#FFA940"/>
                            <TextBlock Text="バッテリー" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Margin="0,0,8,0" Click="OnTestCpuAlertClicked" ToolTip="CPU高温警告をテスト">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="14" Margin="0,0,6,0" Foreground="#FF4D4F"/>
                            <TextBlock Text="CPU高温" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Margin="0,0,8,0" Click="OnTestGpuAlertClicked" ToolTip="GPU高温警告をテスト">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="14" Margin="0,0,6,0" Foreground="#FF4D4F"/>
                            <TextBlock Text="GPU高温" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="OnTestMemoryAlertClicked" ToolTip="メモリ使用量警告をテスト">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Ram20" FontSize="14" Margin="0,0,6,0" Foreground="#FFA940"/>
                            <TextBlock Text="メモリ" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:CardControl>

            <!-- カレンダー・スケジュール連携設定 -->
            <Grid Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CalendarStar24" FontSize="16" Foreground="#0078D4" Margin="0,0,8,0"/>
                    <TextBlock Text="カレンダー・スケジュール連携" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           x:Name="CalendarSyncNowBtn"
                           Appearance="Secondary"
                           Click="OnCalendarSyncNowClicked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="今すぐ同期" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- 1. Google カレンダー連携 -->
            <ui:CardExpander IsExpanded="True" Margin="0,0,0,10">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="CalendarStar24" FontSize="22" Foreground="#4CC2FF" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google カレンダー連携" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="GoogleAccountStatusText" Text="未連携" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" x:Name="GoogleSyncSwitch" Checked="OnGoogleSyncChanged" Unchecked="OnGoogleSyncChanged" VerticalAlignment="Center"/>
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Google アカウントでログインするだけで、OmniGlance と Google カレンダーが安全に双方向連携されます。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <!-- ワンクリックログイン & ログアウトボタン -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button x:Name="GoogleLoginBtn"
                                   Appearance="Primary"
                                   Click="OnGoogleLoginClicked"
                                   Padding="16,8"
                                   Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Google アカウントでログイン" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="GoogleLogoutBtn"
                                   Appearance="Secondary"
                                   Click="OnGoogleLogoutClicked"
                                   Padding="14,8"
                                   Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SignOut24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="ログアウト"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock x:Name="GoogleLoginResultText" Text="" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- 詳細設定 -->
                    <Expander Header="独自の Google Cloud OAuth 設定" Margin="0,0,0,4" FontSize="11">
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OAuth 2.0 クライアント ID" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="GoogleClientIdBox" PlaceholderText="未入力時は内蔵クライアントを使用" TextChanged="OnGoogleCredentialsChanged" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="OAuth クライアント シークレット" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="GoogleClientSecretBox" PlaceholderText="Client Secret" TextChanged="OnGoogleCredentialsChanged" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="※独自の GCP プロジェクトを使用する場合は「デスクトップ アプリ」用の認証情報を作成し、リダイレクト URI に http://127.0.0.1:53841/ を設定してください。" FontSize="9" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ui:CardExpander>

            <!-- 2. iPhone / iCloud カレンダー連携 -->
            <ui:CardExpander IsExpanded="True" Margin="0,0,0,10">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Phone24" FontSize="22" Foreground="#52C41A" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="iCloud カレンダー連携" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="ICloudAccountStatusText" Text="未連携" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" x:Name="ICloudSyncSwitch" Checked="OnICloudSyncChanged" Unchecked="OnICloudSyncChanged" VerticalAlignment="Center"/>
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Apple ID と App 用パスワードを用いて iCloud CalDAV サーバーと直接通信し、iPhone の標準カレンダーと双方向で同期・編集を行います。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <!-- Apple ID & App用パスワード -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Apple ID" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="ICloudAppleIdBox" PlaceholderText="example@icloud.com" TextChanged="OnICloudCredentialsChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="App用パスワード" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="ICloudAppPwBox" PlaceholderText="xxxx-xxxx-xxxx-xxxx" TextChanged="OnICloudCredentialsChanged"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="同期カレンダー名" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="ICloudCalendarNameBox" PlaceholderText="iCloud カレンダー" TextChanged="OnICloudCredentialsChanged"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   x:Name="ICloudTestBtn"
                                   Appearance="Secondary"
                                   Click="OnICloudTestClicked"
                                   VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="接続テスト &amp; 自動検出"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="4"
                                   Appearance="Transparent"
                                   Click="OnOpenAppleIdSecurityClicked"
                                   VerticalAlignment="Bottom"
                                   ToolTip="Apple ID 管理画面をブラウザで開く">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="パスワード発行" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <TextBlock x:Name="ICloudTestResultText" Text="" FontSize="11" Foreground="#52C41A" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <TextBlock Text="※App用パスワードは appleid.apple.com の「アプリ用パスワード」から発行できます。" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- 3. その他のカレンダー購読 -->
            <ui:CardExpander IsExpanded="False" Margin="0,0,0,10">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="その他のカレンダー購読" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="URL 形式の祝日カレンダーや外部購読カレンダー" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   x:Name="AddCalendarBtn"
                                   Appearance="Secondary"
                                   Click="OnAddCalendarClicked"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="購読を追加" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,0">
                    <ItemsControl x:Name="CalendarsItemsControl" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 上段: 有効スイッチ、カラー選択、カレンダー名、削除ボタン -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 有効化チェックボックス -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Checked="OnCalendarItemChanged"
                                                      Unchecked="OnCalendarItemChanged"
                                                      ToolTip="このカレンダーを表示する"/>

                                            <!-- カラー選択ボタン (クリックで色を切り替え) -->
                                            <Button Grid.Column="1"
                                                    Tag="{Binding}"
                                                    Click="OnCalendarColorClicked"
                                                    Padding="2"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="クリックしてカレンダーカラーを変更">
                                                <Ellipse Width="20" Height="20" Fill="{Binding ColorBrush}" Stroke="#80FFFFFF" StrokeThickness="1.5"/>
                                            </Button>

                                            <!-- カレンダー名 -->
                                            <ui:TextBox Grid.Column="2"
                                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{loc:Loc OmniGlance_CalendarName}"
                                                        TextChanged="OnCalendarItemNameOrUrlChanged"
                                                        VerticalAlignment="Center"/>

                                            <!-- 削除ボタン -->
                                            <ui:Button Grid.Column="3"
                                                       Tag="{Binding}"
                                                       Appearance="Transparent"
                                                       Margin="8,0,0,0"
                                                       Padding="6,4"
                                                       Click="OnDeleteCalendarClicked"
                                                       ToolTip="{loc:Loc OmniGlance_DeleteCalendar}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#FF4D4F"/>
                                            </ui:Button>
                                        </Grid>

                                        <!-- 下段: iCal URL 入力欄 -->
                                        <ui:TextBox Grid.Row="1"
                                                    Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{loc:Loc OmniGlance_CalendarIcalPlaceholder}"
                                                    TextChanged="OnCalendarItemNameOrUrlChanged"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:CardExpander>

            <!-- 同期ステータス -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc OmniGlance_CalendarStatus}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CalendarStatusText" Text="未設定" FontSize="11" FontWeight="SemiBold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
